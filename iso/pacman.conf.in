# pacman.conf used by mkarchiso while building the eDEX-OS ISO. Generated into iso/pacman.conf by
# scripts/ci-build-iso.sh with @REPO_DIR@ pointing at the local [edex-os] repository.
[options]
# Keep the live image (and the ISO) under GitHub's 2 GiB release-asset limit; documentation is
# reinstalled with each package on a normal upgrade of the installed system.
NoExtract = usr/share/doc/* usr/share/gtk-doc/*
# ttf-jetbrains-mono-nerd ships six families; eDEX uses "JetBrainsMono Nerd Font" only.
NoExtract = usr/share/fonts/TTF/JetBrainsMonoNL* usr/share/fonts/TTF/JetBrainsMonoNerdFontMono-* usr/share/fonts/TTF/JetBrainsMonoNerdFontPropo-*
HoldPkg      = pacman glibc
Architecture = auto
Color
CheckSpace
VerbosePkgLists
ParallelDownloads = 8
SigLevel    = Required DatabaseOptional
LocalFileSigLevel = Optional

# Packages built from this repository (unsigned, local).
[edex-os]
SigLevel = Optional TrustAll
Server = file://@REPO_DIR@

[cachyos]
Include = /etc/pacman.d/cachyos-mirrorlist

[core]
Include = /etc/pacman.d/mirrorlist

[extra]
Include = /etc/pacman.d/mirrorlist

[multilib]
Include = /etc/pacman.d/mirrorlist
