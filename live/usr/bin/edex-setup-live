#!/usr/bin/env bash
# First-boot setup of the live environment (edex-setup-live.service).
set -euo pipefail
HOME_DIR=/home/liveuser
GROUPS_LIVE=wheel,adm,audio,video,input,storage,network,rfkill,users,tor
# The live user is created here: sysusers.d entries added to the image after pacstrap are not
# applied at boot (systemd-sysusers is gated on ConditionNeedsUpdate=/etc).
if ! id liveuser >/dev/null 2>&1; then
    for g in ${GROUPS_LIVE//,/ }; do getent group "$g" >/dev/null || groupadd -r "$g"; done
    useradd -u 1000 -U -m -k /etc/skel -c "eDEX Live User" -s /usr/bin/fish -G "$GROUPS_LIVE" liveuser
else
    usermod -aG "$GROUPS_LIVE" liveuser
fi
# No password on the live medium (sudo is NOPASSWD, the greeter accepts the empty password).
passwd -d liveuser >/dev/null 2>&1 || true
if [ ! -e "$HOME_DIR/.config/hypr/hyprland.lua" ]; then
    mkdir -p "$HOME_DIR"
    cp -rT /etc/skel "$HOME_DIR"
fi
mkdir -p "$HOME_DIR/Desktop"
cp -f /usr/share/applications/edex-install.desktop "$HOME_DIR/Desktop/" 2>/dev/null || true
chown -R liveuser:liveuser "$HOME_DIR"
# Tor is off until the user turns it on from the privacy panel.
mkdir -p /var/lib/edex-os
echo off > /var/lib/edex-os/tor-mode
echo off > /run/edex-tor-mode
echo "eDEX-OS live setup complete"
