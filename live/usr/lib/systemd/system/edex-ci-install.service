[Unit]
Description=eDEX-OS unattended CI installation to the first disk
# The test boots with systemd.unit=multi-user.target: no desktop is needed to install.
After=multi-user.target network-online.target
Wants=network-online.target
ConditionKernelCommandLine=edex.ci=install

[Service]
Type=oneshot
ExecStart=/usr/bin/edex-ci-install
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
