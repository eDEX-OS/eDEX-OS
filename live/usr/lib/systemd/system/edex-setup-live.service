[Unit]
Description=eDEX-OS live environment setup
# Needs the live user from sysusers.d and the tmpfiles-created state directories.
After=sysinit.target systemd-sysusers.service systemd-tmpfiles-setup.service
Before=greetd.service display-manager.service
ConditionPathExists=/run/archiso

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/edex-setup-live

[Install]
WantedBy=multi-user.target
