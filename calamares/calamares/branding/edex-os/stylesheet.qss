/* eDEX-OS Calamares stylesheet: dark navy with cyan accents */
QWidget { background-color: #0a0e1a; color: #c8e6ff; font-family: "JetBrainsMono Nerd Font", "DejaVu Sans Mono", monospace; }
QLineEdit, QComboBox, QListView, QTreeView, QTextEdit, QPlainTextEdit, QSpinBox { background-color: #0d1117; color: #c8e6ff; border: 1px solid #1f4a5c; selection-background-color: #00d4ff; selection-color: #0a0e1a; }
QPushButton { background-color: #0d2430; color: #c8e6ff; border: 1px solid #00d4ff; padding: 6px 14px; }
QPushButton:hover { background-color: #00d4ff; color: #0a0e1a; }
QPushButton:disabled { color: #4a6a8a; border-color: #1f4a5c; }
QProgressBar { border: 1px solid #00d4ff; background: #0d1117; text-align: center; }
QProgressBar::chunk { background-color: #00d4ff; }
QRadioButton::indicator:checked, QCheckBox::indicator:checked { background-color: #00d4ff; border: 1px solid #00d4ff; }
QRadioButton::indicator, QCheckBox::indicator { width: 12px; height: 12px; border: 1px solid #7ab5d0; background: #0d1117; }
QTabBar::tab { background: #0d1117; padding: 6px 12px; border: 1px solid #1f4a5c; }
QTabBar::tab:selected { background: #0d2430; color: #00d4ff; }
QToolTip { background-color: #0d2430; color: #c8e6ff; border: 1px solid #00d4ff; }
#sidebarApp, #sidebarMenuApp { background-color: #0a0e1a; }
