# Maintainer: eDEX-OS Project <https://github.com/eDEX-OS>
pkgname=edex-os-settings
pkgver=1.0.0
pkgrel=1
pkgdesc="eDEX-OS privacy stack: Tor modes, fail-closed firewall, dnscrypt, MAC randomisation, helpers"
arch=('any')
url="https://github.com/eDEX-OS/eDEX-OS"
license=('GPL-3.0-only')
depends=('nftables' 'dnscrypt-proxy' 'tor' 'networkmanager' 'polkit' 'tailscale' 'systemd' 'bash' 'curl' 'jq')
optdepends=('lyrebird: obfs4 bridges' 'snowflake-pt-client: Snowflake bridges' 'wireguard-tools: WireGuard VPNs' 'openvpn: OpenVPN VPNs')
backup=('etc/edex-os/torrc' 'etc/edex-os/nftables.conf' 'etc/edex-os/dnscrypt-proxy.toml' 'etc/sysctl.d/90-edex-privacy.conf')
install=edex-os-settings.install
source=("$pkgname-$pkgver.tar")
sha256sums=('SKIP')

package() {
    cd "$srcdir/$pkgname-$pkgver"
    cp -a etc "$pkgdir/"
    cp -a usr "$pkgdir/"
    chmod 755 "$pkgdir"/usr/bin/*
    chmod 750 "$pkgdir/etc/tor/torrc.d"
}
