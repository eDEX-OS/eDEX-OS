post_install() {
    systemd-sysusers >/dev/null 2>&1 || true
    systemd-tmpfiles --create edex-os.conf >/dev/null 2>&1 || true
    chgrp tor /etc/tor/torrc.d 2>/dev/null || true
    sysctl --system >/dev/null 2>&1 || true
    systemctl daemon-reload >/dev/null 2>&1 || true
}
post_upgrade() {
    post_install
}
